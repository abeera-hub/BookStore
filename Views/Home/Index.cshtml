@model BookStore.ViewModels.HomeViewModel
<h2>Welcome to Book Store</h2>
<h3>Available Books</h3>
@if (Model.Books.Count == 0)
{
    <p>No books available</p>
}
else
{
    @foreach (var book in Model.Books)
    {
        <div class="book-card">
            <h4>@book.Title</h4>
            <p>Author: @book.AuthorName</p>
            <p>Price: @book.Price</p>
            <form method="post" action="/Home/RemoveBook"
                  onsubmit="return confirmRemove()">

                <input type="hidden" name="id" value="@book.Id" />
                <button type="submit">Remove</button>

            </form>
        </div>
    }
}

<h3>Add New Book</h3>
<form method="post" action="/Home/AddBook">

    <label>Title</label>
    <input type="text" name="title" />

    <br />

    <label>Price</label>
    <input type="number" name="price" />

    <br />

    <label>Author</label>

    <select name="authorId">
        @foreach (var author in Model.Authors)
        {
            <option value="@author.Id">@author.Name</option>
        }
    </select>

    <br />

    <button type="submit">Add Book</button>

</form>
<h3>Add New Author</h3>
<form method="post" action="/Home/AddAuthor">

    <label>Name</label>
    <input type="text" name="name" />

    <br />
    <label>Country</label>
    <input type="text" name="country" />

    <br />
    <button type="submit">Add Author</button>

</form>

@section Styles {
    <style>
        .book-card {
            border: 1px solid black;
            padding: 10px;
            margin: 10px;
            width: 250px;
        }
    </style>
}

@section Scripts {
    <script>
        function confirmRemove() {
            return confirm("Remove this book?");
        }
    </script>
}